<!-- SOC Home Lab: custom rules. Dat vao /var/ossec/etc/rules/local_rules.xml -->
<!-- Kiem tra cu phap: sudo /var/ossec/bin/wazuh-analysisd -t ; ap dung: sudo systemctl restart wazuh-manager -->

<group name="local,soc_lab,windows,">
  <!-- S01: nhieu lan dang nhap Windows that bai cung mot tai khoan trong 60 giay -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>SOC-LAB S01: Multiple failed Windows logons for the same account within 60 seconds</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>
